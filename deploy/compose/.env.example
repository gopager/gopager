# Copy to .env and set real values. Never commit .env.
# Use a URL-safe password (letters, digits, "-", "_", "."): it is embedded in the
# database connection URL.
POSTGRES_PASSWORD=change-me

# Host port that publishes the GoPager HTTP listener.
GOPAGER_PORT=8080

# Origin users type into the browser; GoPager does not terminate TLS, so put a
# TLS proxy in front for anything beyond localhost and use its https:// origin.
GOPAGER_PUBLIC_ORIGIN=http://localhost:8080
